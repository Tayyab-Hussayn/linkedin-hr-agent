{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qalam",
  "version": "1.4.0",
  "identifier": "com.byqalam.app",
  "build": {
    "frontendDist": "../dashboard/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../dashboard && npm run dev",
    "beforeBuildCommand": "cd ../dashboard && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Qalam",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.byqalam.com http://localhost:5050 http://localhost:5678; img-src 'self' data: https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "dmg"],
    "externalBin": [
      "binaries/qalam-worker"
    ],
    "resources": {
      "resources/linkedin_actions.py": "linkedin_actions.py",
      "resources/humanizer.py": "humanizer.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
