{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qalam",
  "version": "0.1.0",
  "identifier": "com.byqalam.app",
  "build": {
    "frontendDist": "../dashboard/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../dashboard && npm run dev",
    "beforeBuildCommand": "cd ../dashboard && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Qalam",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.byqalam.com/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyM0EyM0YzQUZCRkE4RDIKUldUU3FMK3Y4eU02WWpvWUs5VjFmbW9nZ3ZxS2N1UGVlT21WZHVoS3ZBOGxKQUJyWWNiTnVOZlYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "dmg"],
    "externalBin": [
      "binaries/qalam-worker"
    ],
    "resources": {
      "resources/linkedin_actions.py": "linkedin_actions.py",
      "resources/humanizer.py": "humanizer.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
